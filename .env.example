# Copie para .env e preencha. O .env está no .gitignore e nunca é commitado.
#
# Este arquivo é só para variáveis de execução da aplicação.
# Secrets de CI/CD (ANTHROPIC_API_KEY, SSH_*, ENV_FILE) ficam em
# Settings > Secrets and variables > Actions. Veja docs/ci-cd.md.

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=bolsiq
POSTGRES_PASSWORD=
POSTGRES_DB=bolsiq
DATABASE_URL=postgres://bolsiq:@localhost:5432/bolsiq

# --- Mensageria ------------------------------------------------------------
NATS_URL=nats://localhost:4222

# --- Observabilidade -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Imagens ---------------------------------------------------------------
# Tag das imagens no GHCR. Em deploy é injetada pelo workflow; localmente
# não é usada.
IMAGE_TAG=develop

# --- E-mail ----------------------------------------------------------------
# Em desenvolvimento aponta para o Mailpit do compose (make up), que captura
# tudo em http://localhost:8025 e nao entrega a ninguem.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=nao-responda@bolsiq.local

# --- Autenticacao ----------------------------------------------------------
# Segredo de assinatura das sessoes do Better Auth. Gere com:
#   openssl rand -base64 32
# Obrigatorio fora de desenvolvimento (minimo 32 caracteres). A URL publica
# do app (links de e-mail, callback do Google) e o APP_URL, abaixo.
BETTER_AUTH_SECRET=
# Tentativas de login, cadastro, recuperacao e 2FA por IP por minuto.
AUTH_RATE_LIMIT=10

# Login com Google. Credenciais em console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Banco da aplicacao ----------------------------------------------------
# O app conecta com DATABASE_URL e, em toda transacao do portfolio, faz
# SET LOCAL ROLE bolsiq_app (sem BYPASSRLS, nao dono das tabelas): e assim que
# a RLS vale (ADR 0011 e 0022). Fora do compose, o login do DATABASE_URL
# precisa ser membro do papel: GRANT bolsiq_app TO <login>.

# --- portfolio-worker -----------------------------------------------------
# Snapshot do fechamento (cron, horario de Brasilia) e intervalo do laco que
# recalcula as carteiras marcadas pelo app.
SNAPSHOT_CRON=0 19 * * 1-5
RECALCULO_MS=2000

# --- Alertas ---------------------------------------------------------------
# Web Push (PWA). Gere o par com: npx web-push generate-vapid-keys
# Sem as duas chaves, o canal push fica desligado e o worker avisa no log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@bolsiq.local
# Telegram: canal opcional, so liga com a flag E o token.
FEATURE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
APP_URL=http://localhost:3000

# --- Fontes de dados -------------------------------------------------------
# Token da brapi. Sem ele, so os tickers de demonstracao (PETR4, VALE3, ITUB4,
# MGLU3) tem cotacao e proventos; o IBOV vem do BOVA11 como aproximacao.
BRAPI_TOKEN=
# Atraso da cotacao informado em meta.delay_minutes, e validade do cache.
BRAPI_DELAY_MINUTES=15
QUOTE_TTL_SECONDS=60

# Meses do informe diario de fundos da CVM no `make backfill` (~500 mil
# linhas por mes). 13 cobre o periodo 1A do comparador.
FUNDOS_MESES=13

# --- market-data: administracao -------------------------------------------
# Token das rotas /admin (Authorization: Bearer). Minimo de 16 caracteres.
# Sem ele, /admin recusa tudo. Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# --- apps/web --------------------------------------------------------------
# Chave interna do BFF para o /v1 (ADR 0020). So no servidor: nada com
# prefixo NEXT_PUBLIC_, e o build reprova se o prefixo mdk_ aparecer no bundle.
MARKET_DATA_API_KEY=

# --- Assistente (ADR 0024) ---------------------------------------------------
# Cifra a chave de provedor de cada usuario. Gere com: openssl rand -base64 32
# Trocar a chave-mestra invalida as chaves ja salvas: cada usuario cola de novo.
ASSISTANT_MASTER_KEY=
# personal: mostra sugestoes de aporte (uso proprio).
# educational: so analise e candidatos, sem linguagem de recomendacao. Obrigatorio
# antes de abrir para terceiros: recomendacao personalizada e atividade regulada
# pela CVM e precisa de avaliacao juridica.
ASSISTANT_RECOMMENDATIONS=personal
# Mensagens por usuario por dia.
ASSISTANT_DAILY_MESSAGES=100
# Ollama: URL padrao e hosts aceitos no campo da tela (o servidor e quem chama).
ASSISTANT_OLLAMA_URL=http://host.docker.internal:11434
ASSISTANT_OLLAMA_HOSTS=host.docker.internal,ollama
# Opcional: outro endereco para a DeepSeek (proxy). Vazio usa o oficial.
ASSISTANT_DEEPSEEK_URL=
# Chave da plataforma, padrao para quem nao configurou a propria. Vazia: desligada.
ASSISTANT_PLATFORM_KEY=
ASSISTANT_PLATFORM_PROVIDER=deepseek
ASSISTANT_PLATFORM_MODEL=deepseek-flash
# Mensagens por dia na chave da plataforma, por plano.
ASSISTANT_PLATFORM_LIMITS=gratis:20

# --- analytics-worker ------------------------------------------------------
# O analytics e o apps/web leem dado de mercado pela API, nunca pelo banco
# market_data (ADR 0009). Com o Kong, aponta para o gateway.
MARKET_DATA_URL=http://localhost:3001
RECALC_CONCURRENCY=4

# Secret já configurado no repositório. Propósito ainda não definido e
# nenhum workflow o usa. Se a intenção era PKG_TOKEN para publicar pacotes,
# renomeie: o push de imagens para o GHCR usa o GITHUB_TOKEN automático.
PGK_TOKEN=
