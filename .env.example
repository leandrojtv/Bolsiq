# Copie para .env e preencha. O .env está no .gitignore e nunca é commitado.
#
# Este arquivo é só para variáveis de execução da aplicação.
# Secrets de CI/CD (ANTHROPIC_API_KEY, SSH_*, ENV_FILE) ficam em
# Settings > Secrets and variables > Actions. Veja docs/ci-cd.md.

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=bolsiq
POSTGRES_PASSWORD=
POSTGRES_DB=bolsiq
DATABASE_URL=postgres://bolsiq:@localhost:5432/bolsiq

# --- Mensageria ------------------------------------------------------------
NATS_URL=nats://localhost:4222

# --- Observabilidade -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Imagens ---------------------------------------------------------------
# Tag das imagens no GHCR. Em deploy é injetada pelo workflow; localmente
# não é usada.
IMAGE_TAG=develop

# --- E-mail ----------------------------------------------------------------
# Em desenvolvimento aponta para o Mailpit do compose (make up), que captura
# tudo em http://localhost:8025 e nao entrega a ninguem.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=nao-responda@bolsiq.local

# --- Autenticacao ----------------------------------------------------------
# Segredo de assinatura das sessoes do Better Auth. Gere com:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Login com Google. Credenciais em console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Banco da aplicacao ----------------------------------------------------
# Papel sem BYPASSRLS e que NAO e dono das tabelas. A RLS do schema portfolio
# so protege se a aplicacao conectar com ele. Ver ADR 0011.
DATABASE_URL_APP=postgres://bolsiq_app:@localhost:5432/bolsiq

# --- Fontes de dados -------------------------------------------------------
# Token da brapi, quando houver plano pago.
BRAPI_TOKEN=

# Secret já configurado no repositório. Propósito ainda não definido e
# nenhum workflow o usa. Se a intenção era PKG_TOKEN para publicar pacotes,
# renomeie: o push de imagens para o GHCR usa o GITHUB_TOKEN automático.
PGK_TOKEN=
