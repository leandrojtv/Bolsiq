{
  "name": "@bolsiq/db-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@bolsiq/contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@bolsiq/config": "workspace:*",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
