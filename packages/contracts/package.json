{
  "name": "@bolsiq/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run --coverage",
    "docs:events": "tsx scripts/gerar-docs-eventos.ts",
    "docs:events:check": "tsx scripts/gerar-docs-eventos.ts --check"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@bolsiq/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^5.7.2",
    "vitest": "4.1.12",
    "tsx": "^4.19.2"
  }
}
