# Copie para .env e preencha. O .env está no .gitignore e nunca é commitado.
#
# Este arquivo é só para variáveis de execução da aplicação.
# Secrets de CI/CD (ANTHROPIC_API_KEY, SSH_*, ENV_FILE) ficam em
# Settings > Secrets and variables > Actions. Veja docs/ci-cd.md.

# --- Banco -----------------------------------------------------------------
POSTGRES_USER=bolsiq
POSTGRES_PASSWORD=
POSTGRES_DB=bolsiq
DATABASE_URL=postgres://bolsiq:@localhost:5432/bolsiq

# --- Mensageria ------------------------------------------------------------
NATS_URL=nats://localhost:4222

# --- Observabilidade -------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# --- Imagens ---------------------------------------------------------------
# Tag das imagens no GHCR. Em deploy é injetada pelo workflow; localmente
# não é usada.
IMAGE_TAG=develop

# --- E-mail ----------------------------------------------------------------
# Em desenvolvimento aponta para o Mailpit do compose (make up), que captura
# tudo em http://localhost:8025 e nao entrega a ninguem.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=nao-responda@bolsiq.local

# --- Autenticacao ----------------------------------------------------------
# Segredo de assinatura das sessoes do Better Auth. Gere com:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Login com Google. Credenciais em console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Banco da aplicacao ----------------------------------------------------
# Papel sem BYPASSRLS e que NAO e dono das tabelas. A RLS do schema portfolio
# so protege se a aplicacao conectar com ele. Ver ADR 0011.
DATABASE_URL_APP=postgres://bolsiq_app:@localhost:5432/bolsiq

# --- Alertas ---------------------------------------------------------------
# Web Push (PWA). Gere o par com: npx web-push generate-vapid-keys
# Sem as duas chaves, o canal push fica desligado e o worker avisa no log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@bolsiq.local
# Telegram: canal opcional, so liga com a flag E o token.
FEATURE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
APP_URL=http://localhost:3000

# --- Fontes de dados -------------------------------------------------------
# Token da brapi. Sem ele, so os tickers de demonstracao (PETR4, VALE3, ITUB4,
# MGLU3) tem cotacao e proventos; o IBOV vem do BOVA11 como aproximacao.
BRAPI_TOKEN=
# Atraso da cotacao informado em meta.delay_minutes, e validade do cache.
BRAPI_DELAY_MINUTES=15
QUOTE_TTL_SECONDS=60

# --- market-data: administracao -------------------------------------------
# Token das rotas /admin (Authorization: Bearer). Minimo de 16 caracteres.
# Sem ele, /admin recusa tudo. Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# --- analytics-worker ------------------------------------------------------
# O analytics le dado de mercado pela API, nunca pelo banco (ADR 0009).
MARKET_DATA_URL=http://localhost:3001
RECALC_CONCURRENCY=4

# Secret já configurado no repositório. Propósito ainda não definido e
# nenhum workflow o usa. Se a intenção era PKG_TOKEN para publicar pacotes,
# renomeie: o push de imagens para o GHCR usa o GITHUB_TOKEN automático.
PGK_TOKEN=
